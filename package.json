{
  "name": "kraft-portfolio",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @shots",
    "shots": "playwright test --grep @shots --project=desktop",
    "thumbs": "node scripts/make-thumbs.mjs",
    "placeholders": "node scripts/placeholders.ts",
    "plan": "node scripts/make-plan.ts && node scripts/shoot-plan.mjs",
    "e2e-page": "node scripts/make-e2e.ts && node scripts/shoot-e2e.mjs",
    "af-page": "node scripts/make-af.ts && node scripts/shoot-af.mjs",
    "agents-page": "node scripts/make-agents.ts && node scripts/shoot-agents.mjs",
    "automations-page": "node scripts/make-automations.ts && node scripts/shoot-automations.mjs",
    "cases": "node scripts/make-cases.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "simple-icons": "16.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
