# Copy to .env.local for local runs. On Vercel, set these under Project → Settings → Environment Variables.

# The site's public address, used by canonical links, the sitemap and the share image.
# Unset on Vercel, the project's production domain is used.
NEXT_PUBLIC_SITE_URL=

# The contact form sends through Resend (app/api/contact/route.ts). All three are server-only.
# Without them the form shows an error and your email address.
# API key from resend.com/api-keys.
RESEND_API_KEY=
# The sender. onboarding@resend.dev works for testing but only delivers to your Resend account's
# own email, so visitors get no confirmation until this is an address on a domain verified in Resend.
CONTACT_FROM=Kraft <onboarding@resend.dev>
# Where messages land.
CONTACT_TO=

# The site assistant (app/api/chat/route.ts): a chat button on every page that answers questions about Justine's work and passes messages on.
# Key from console.anthropic.com. Unset: the assistant is off and its button is hidden. Adding it takes a redeploy.
ANTHROPIC_API_KEY=
# Conversation logging. Both are server-only.
# Unset: chats work and are not logged. Run supabase/migrations/0001_assistant.sql once in the Supabase SQL editor (enable pg_cron first under Database → Extensions).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Tests only: scripted replies, no emails, no logging. Never set in production.
# ASSISTANT_FAKE=1
