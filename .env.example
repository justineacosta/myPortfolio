# Copy to .env.local for local runs. On Vercel, set these under Project → Settings → Environment Variables.

# The site's public address, used by canonical links, the sitemap and the share image.
# Unset on Vercel, the project's production domain is used.
NEXT_PUBLIC_SITE_URL=

# The contact form sends through Resend (app/api/contact/route.ts). All three are server-only.
# Without them the form shows an error and your email address.
# API key from resend.com/api-keys.
RESEND_API_KEY=
# The sender address. Each email sets its own sender name (data/contact.ts), so a name here is ignored.
# onboarding@resend.dev works for testing but only delivers to your Resend account's
# own email, so visitors get no confirmation until this is an address on a domain verified in Resend.
CONTACT_FROM=Kraft <onboarding@resend.dev>
# Where messages land.
CONTACT_TO=

# The site chat answers through Anthropic (app/api/chat/route.ts). The key is server-only.
# Without it the chat still shows and answers from the site's FAQs and topics, at no cost (lib/chat/fallback.ts).
# The layout reads it at build, so a change needs a redeploy.
# API key from console.anthropic.com. Set a monthly spend limit for its workspace there (Settings → Limits).
ANTHROPIC_API_KEY=
# Optional: the model the chat asks. Leave it empty for the default, Claude Opus 5.5 (claude-opus-5-5).
ANTHROPIC_MODEL=
